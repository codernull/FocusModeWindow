[
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children":
        [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children":
                [
                    {
                        "caption": "Focus Mode Window",
                        "children":
                        [
                            {
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/FocusModeWindow/Focus Mode Window.sublime-settings",
                                    "default": "// Focus Mode Window user settings\n{\n\t$0\n}\n"
                                },
                                "caption": "Settings"
                            },
                            { "caption": "-" },
                            {
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/FocusModeWindow/Focus Mode Window.sublime-color-scheme",
                                    "default": "{\n\t\"extends\": \"Mariana.sublime-color-scheme\",\n\t\"variables\": {},\n\t\"globals\": {\n\t\t\"background\": \"#1f2329\",\n\t\t\"foreground\": \"#d6deeb\",\n\t\t\"line_highlight\": \"#343b45\"\n\t},\n\t\"rules\": []\n}\n"
                                },
                                "caption": "Color Scheme"
                            },
                            { "caption": "-" },
                            {
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/FocusModeWindow/Default (Windows).sublime-keymap",
                                    "default": "[\n\t$0\n]\n"
                                },
                                "caption": "Key Bindings"
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
