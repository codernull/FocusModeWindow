{
    "name": "Focus Mode Window",
    "author": "Focus Mode Window",
    "extends": "Mariana.sublime-color-scheme",
    "variables": {},
    "globals": {
        "background": "#1b1d1f",
        "foreground": "#c7ccd4",
        "line_highlight": "#31363d"
    },
    "rules": [
        {
            "name": "Markdown Headings",
            "scope": "markup.heading.markdown, entity.name.section.markdown",
            "foreground": "#d8dee9",
            "font_style": "bold"
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold.markdown",
            "foreground": "#d8dee9",
            "font_style": "bold"
        },
        {
            "name": "Markdown Italic",
            "scope": "markup.italic.markdown",
            "foreground": "#d8dee9",
            "font_style": "italic"
        },
        {
            "name": "Markdown Lists",
            "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown, punctuation.definition.list_item.markdown",
            "foreground": "#a3be8c"
        },
        {
            "name": "Markdown Links",
            "scope": "meta.link.inline.markdown, markup.underline.link.markdown",
            "foreground": "#81a1c1"
        },
        {
            "name": "Markdown Inline Code",
            "scope": "markup.raw.inline.markdown",
            "foreground": "#ebcb8b",
            "background": "#2e3440"
        },
        {
            "name": "Markdown Blockquote",
            "scope": "markup.quote.markdown",
            "foreground": "#b48ead",
            "font_style": "italic"
        }
    ]
}
