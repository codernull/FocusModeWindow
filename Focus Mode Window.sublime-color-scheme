{
    // Palette adapted from "Focus (dark)" by Sindre Sorhus
    // (https://github.com/sindresorhus/focus, MIT). The idea is identical:
    // a calm, warm-neutral dark background where syntax tokens are pressed
    // down close to the background ("dim") so code reads as a uniform, quiet
    // block, while prose / strings / headings stay readable ("bright"). The
    // current line is marked by a soft, natural highlight band - never a harsh
    // colored bar.
    "name": "Focus Mode Window",
    "author": "Focus Mode Window (palette from Focus by Sindre Sorhus, MIT)",

    "variables": {
        "background": "#1b1d1f",
        "dim": "#34373b",
        "subtle": "#999b99",
        "bright": "#c5c8c6",
        "foreground": "#c2c5bd",
        "caret": "#b6b7b5",
        "line_highlight": "#2b3550",
        "selection": "#34373b",
        "inactive_selection": "#2a2c30",
        "invisibles": "#43464c",
        "gutter_fg": "#34373b",
        "invalid": "#8a5a64"
    },

    "globals": {
        "background": "var(background)",
        "foreground": "var(foreground)",
        "caret": "var(caret)",
        "line_highlight": "var(line_highlight)",
        "selection": "var(selection)",
        "selection_border": "var(selection)",
        "inactive_selection": "var(inactive_selection)",
        "invisibles": "var(invisibles)",
        "gutter": "var(background)",
        "gutter_foreground": "var(gutter_fg)",
        "line_diff_added": "var(dim)",
        "line_diff_modified": "var(dim)",
        "line_diff_deleted": "var(dim)"
    },

    // No "extends": standalone so syntax highlighting cannot reintroduce bright
    // token colors. Mirrors the Focus theme's scope mapping.
    "rules": [
        {
            "name": "All (dim every token toward the background)",
            "scope": "comment, constant, entity, invalid, keyword, markup, meta, storage, string, support, variable, source",
            "foreground": "var(dim)"
        },
        {
            "name": "Show (prose, quoted strings, section headings)",
            "scope": "string.quoted, meta.paragraph, entity.name.section",
            "foreground": "var(bright)"
        },
        {
            "name": "Show subtle (LaTeX math and macros)",
            "scope": "text.tex.latex support.function.general.tex, support.function.section.latex, string.other.math.block.environment.latex, text.tex.latex string.other.math.tex, text.tex.latex constant.other.general.math.tex, text.tex.latex invalid.illegal.string",
            "foreground": "var(subtle)"
        },
        {
            "name": "Hide quoted strings in HTML/XML",
            "scope": "string.quoted.double.html, string.quoted.double.xml",
            "foreground": "var(dim)"
        },
        {
            "name": "Markdown show (inline code, links, quotes)",
            "scope": "markup.raw.inline.markdown, string.other.link.title.markdown, string.other.link.description.markdown, markup.quote.markdown",
            "foreground": "var(bright)"
        },
        {
            "name": "Markdown show subtle (link URLs)",
            "scope": "markup.underline.link.markdown, markup.underline.link.image.markdown",
            "foreground": "var(subtle)"
        },
        {
            "name": "Markdown hide (image/link metadata)",
            "scope": "meta.image.inline.markdown, meta.link.inline.markdown",
            "foreground": "var(dim)"
        },
        {
            "name": "Invalid (kept faint, slightly warm)",
            "scope": "invalid.illegal",
            "foreground": "var(invalid)"
        }
    ]
}
