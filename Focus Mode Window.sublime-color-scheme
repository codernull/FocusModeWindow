{
    "name": "Focus Mode Window",
    "author": "Focus Mode Window",
    "extends": "Mariana.sublime-color-scheme",
    "variables": {},
    "globals": {
        "background": "#1f2329",
        "foreground": "#d6deeb",
        "line_highlight": "#343b45",
        "caret": "#ffffff",
        "selection": "#3f536b",
        "selection_foreground": "#ffffff"
    },
    "rules": [
        {
            "name": "Markdown headings",
            "scope": "markup.heading",
            "foreground": "#82aaff",
            "font_style": "bold"
        },
        {
            "name": "Markdown links",
            "scope": "markup.underline.link, meta.link.inline.markdown",
            "foreground": "#89ddff"
        },
        {
            "name": "Markdown wiki links",
            "scope": "constant.other.reference.link.markdown, punctuation.definition.constant.markdown",
            "foreground": "#c792ea"
        },
        {
            "name": "Markdown code",
            "scope": "markup.raw",
            "foreground": "#f78c6c"
        },
        {
            "name": "Markdown blockquotes",
            "scope": "markup.quote.markdown",
            "foreground": "#c3e88d"
        }
    ]
}
