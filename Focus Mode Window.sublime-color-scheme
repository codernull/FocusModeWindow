{
    "name": "Focus Mode Window",
    "author": "Focus Mode Window",
    "variables": {
        "background": "#1F2329",
        "foreground": "#A7B2C6",
        "caret": "#528BFF",
        "line_highlight": "#383E4A",
        "selection": "#3E4451",
        "inactive_selection": "#2C313C",
        "invisibles": "#3B4048",
        "gutter_fg": "#4B5263",
        "invalid": "#E06C75",
        "paragraph_band": "#232830",
        
        "keyword": "#C678DD",
        "string": "#98C379",
        "comment": "#5C6370",
        "function": "#61AFEF",
        "variable": "#E06C75",
        "constant": "#D19A66",
        "type": "#E5C07B"
    },
    "globals": {
        "background": "var(background)",
        "foreground": "var(foreground)",
        "caret": "var(caret)",
        "line_highlight": "var(line_highlight)",
        "selection": "var(selection)",
        "selection_border": "var(selection)",
        "inactive_selection": "var(inactive_selection)",
        "invisibles": "var(invisibles)",
        "gutter": "var(background)",
        "gutter_foreground": "var(gutter_fg)",
        "line_diff_added": "var(string)",
        "line_diff_modified": "var(type)",
        "line_diff_deleted": "var(invalid)"
    },
    "rules": [
        {
            "name": "Comment",
            "scope": "comment",
            "foreground": "var(comment)",
            "font_style": "italic"
        },
        {
            "name": "String",
            "scope": "string",
            "foreground": "var(string)"
        },
        {
            "name": "Keyword",
            "scope": "keyword, storage",
            "foreground": "var(keyword)"
        },
        {
            "name": "Function",
            "scope": "entity.name.function, support.function",
            "foreground": "var(function)"
        },
        {
            "name": "Variable",
            "scope": "variable",
            "foreground": "var(variable)"
        },
        {
            "name": "Constant",
            "scope": "constant",
            "foreground": "var(constant)"
        },
        {
            "name": "Type",
            "scope": "entity.name.type, entity.name.class, support.type, support.class",
            "foreground": "var(type)"
        },
        {
            "name": "Focus paragraph spotlight",
            "scope": "focusmode.paragraph",
            "foreground": "var(paragraph_band)",
            "background": "var(paragraph_band)"
        }
    ]
}
