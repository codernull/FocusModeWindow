{
    "name": "Focus Mode Window",
    "author": "Focus Mode Window",
    "extends": "Packages/Color Scheme - Default/Mariana.sublime-color-scheme",
    "variables": {},
    "globals": {
        "background": "#1b1d1f",
        "foreground": "#5c6370",
        "line_highlight": "#31363d",
        "caret": "#ffffff"
    },
    "rules": [
        {
            "name": "Dim Headings",
            "scope": "markup.heading",
            "foreground": "#5c677d"
        },
        {
            "name": "Dim Bold and Italic",
            "scope": "markup.bold, markup.italic",
            "foreground": "#6b7280"
        },
        {
            "name": "Dim Links",
            "scope": "markup.underline.link",
            "foreground": "#4a5568"
        },
        {
            "name": "Dim Code Blocks and Inline Code",
            "scope": "markup.raw",
            "foreground": "#4b5563"
        },
        {
            "name": "Dim Lists",
            "scope": "markup.list",
            "foreground": "#5a5a52"
        },
        {
            "name": "Wiki Links",
            "scope": "constant.other.reference.link.markdown, punctuation.definition.constant.markdown",
            "foreground": "#6b7280"
        },
        {
            "name": "Blockquotes",
            "scope": "markup.quote.markdown",
            "foreground": "#5c6370"
        },
        {
            "name": "Blockquote Punctuation",
            "scope": "punctuation.definition.blockquote.markdown",
            "foreground": "#4b5263"
        },
        {
            "name": "Dim Punctuation",
            "scope": "punctuation.definition",
            "foreground": "#4b5563"
        }
    ]
}