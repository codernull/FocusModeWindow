{
    // Color scheme applied to every view while focus mode is on.
    // Restored to your normal scheme when you exit focus mode.
    // NOTE: .sublime-color-scheme files are referenced by FILENAME ONLY
    // (not a Packages/... path) - that is what Sublime Text 4 expects.
    "color_scheme": "Focus Mode Window.sublime-color-scheme",

    // Center the text column. Set to false to align left.
    "draw_centered": false,

    // Enable word wrap.
    "word_wrap": true,

    // Soft-wrap column. Set to 0 to wrap at the window width.
    "wrap_width": 0,
    
    // Horizontal margin.
    "margin": 0,

    // Vertical breathing room between lines.
    "line_padding_top": 7,
    "line_padding_bottom": 2,

    // Font size applied while in focus mode (restored on exit).
    // Set to 0 to keep your normal font size and leave Ctrl+-/= zoom untouched.
    "font_size": 0,

    // Draw a soft background over the caret's current paragraph.
    "highlight_paragraph": true,

    // Optionally dim only the visible viewport outside the current paragraph.
    // Off by default to keep the effect conservative.
    "dim_non_current_viewport": false,

    // Color-scheme scopes used by the dynamic regions.
    "paragraph_highlight_scope": "focus.paragraph",
    "dim_highlight_scope": "focus.dim",

    // Minimum delay between region redraws during rapid caret movement.
    "region_update_throttle_ms": 30,

    // Set to true to also enter OS full screen on focus. Off by default.
    "full_screen": false
}
