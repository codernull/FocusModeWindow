[
    {
        "caption": "Focus Mode Window: Toggle",
        "command": "toggle_focus_mode_window"
    },
    {
        "caption": "Focus Mode Window: Enter",
        "command": "toggle_focus_mode_window",
        "args": {
            "force": true
        }
    },
    {
        "caption": "Focus Mode Window: Exit",
        "command": "toggle_focus_mode_window",
        "args": {
            "force": false
        }
    },
    {
        "caption": "Focus Mode Window: Diagnose",
        "command": "focus_mode_window_diagnose"
    },
    {
        "caption": "Preferences: Focus Mode Window Settings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/FocusModeWindow/Focus Mode Window.sublime-settings",
            "default": "// Focus Mode Window user settings\n{\n\t$0\n}\n"
        }
    },
    {
        "caption": "Preferences: Focus Mode Window Color Scheme",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/FocusModeWindow/Focus Mode Window.sublime-color-scheme",
            "default": "{\n\t\"variables\": {},\n\t\"globals\": {},\n\t\"rules\": []\n}\n"
        }
    },
    {
        "caption": "Preferences: Focus Mode Window Key Bindings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/FocusModeWindow/Default (Windows).sublime-keymap",
            "default": "[\n\t$0\n]\n"
        }
    }
]
